@{
    Layout = "_ErrorLayout";
    ViewData["Title"] = "Geçersiz istek";
}

<div class="error-icon"><i class="bi bi-signpost-split"></i></div>
<div class="error-code">400</div>
<h1>Geçersiz istek</h1>
<p>Formun süresi dolmuş ya da oturumunuz değişmiş olabilir. Sayfayı yenileyip tekrar deneyin.</p>

<div class="error-actions">
    <a class="btn-primary-x" asp-controller="Home" asp-action="Index">
        <span class="lbl">Ana Sayfaya Dön</span><i class="bi bi-arrow-right"></i>
    </a>
    <button type="button" class="btn-ghost" onclick="history.back()">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </button>
</div>