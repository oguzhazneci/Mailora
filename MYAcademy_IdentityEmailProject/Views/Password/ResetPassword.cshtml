@model ResetPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_RegisterStyleComponentPartial", new { title = "Şifre Yenileme" })
<body>

    <div class="auth-bg" aria-hidden="true"><span class="g1"></span><span class="g2"></span><span class="g3"></span></div>

    <main class="auth-page">
        <div class="auth-card">

            @await Component.InvokeAsync("_RegisterBrandComponentPartial")

            <section class="auth-form-wrap">
                <div class="form-head">
                    <h1>Yeni Şifre Belirleyin</h1>
                    <p>Hesabınız için yeni bir şifre oluşturun. Bu sayfayı yalnızca bir kez kullanabilirsiniz.</p>
                </div>

                <form asp-controller="Password" asp-action="ResetPassword" method="post" novalidate>
                    <div asp-validation-summary="All" class="server-alert"></div>
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Token" />

                    <div class="form-grid">
                        <div class="field span-2">
                            <label asp-for="NewPassword">Yeni Şifre</label>
                            <div class="input-wrap">
                                <i class="bi bi-lock lead"></i>
                                <input class="a-input has-eye" asp-for="NewPassword" type="password"
                                       placeholder="Güçlü bir şifre belirleyin" autocomplete="new-password" autofocus>
                                <button type="button" class="eye-btn" data-eye="NewPassword" aria-label="Şifreyi göster" title="Şifreyi göster"><i class="bi bi-eye"></i></button>
                            </div>
                            <div class="hint">En az 8 karakter; büyük harf, küçük harf, rakam ve özel karakter içermeli.</div>
                        </div>

                        <div class="field span-2">
                            <label asp-for="ConfirmPassword">Yeni Şifre Tekrar</label>
                            <div class="input-wrap">
                                <i class="bi bi-shield-lock lead"></i>
                                <input class="a-input has-eye" asp-for="ConfirmPassword" type="password"
                                       placeholder="Yeni şifrenizi tekrar girin" autocomplete="new-password">
                                <button type="button" class="eye-btn" data-eye="ConfirmPassword" aria-label="Şifreyi göster" title="Şifreyi göster"><i class="bi bi-eye"></i></button>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn-primary-x">
                        <span class="lbl">Şifremi Güncelle</span><i class="bi bi-arrow-right"></i>
                    </button>
                </form>

                <div class="form-foot">Şifrenizi hatırladınız mı? <a asp-controller="Login" asp-action="SignIn">Giriş Yap</a></div>
            </section>
        </div>
    </main>

    <script>
            // Şifre göster / gizle
            document.querySelectorAll('[data-eye]').forEach(btn => btn.addEventListener('click', () => {
                const input = document.getElementById(btn.dataset.eye);
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                btn.title = show ? 'Şifreyi gizle' : 'Şifreyi göster';
                btn.setAttribute('aria-label', btn.title);
            }));
    </script>
</body>
</html>