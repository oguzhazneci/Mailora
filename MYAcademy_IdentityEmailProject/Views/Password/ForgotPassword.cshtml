@model ForgotPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_RegisterStyleComponentPartial", new { title = "Şifremi Unuttum" })
<body>

    <div class="auth-bg" aria-hidden="true"><span class="g1"></span><span class="g2"></span><span class="g3"></span></div>

    <main class="auth-page">
        <div class="auth-card">

            @await Component.InvokeAsync("_RegisterBrandComponentPartial")

            <section class="auth-form-wrap">
                <div class="form-head">
                    <h1>Şifremi Unuttum</h1>
                    <p>Hesabınıza kayıtlı e-posta adresini girin. Şifrenizi yenilemeniz için size bir bağlantı göndereceğiz.</p>
                </div>

                <partial name="_AuthMessages" />

                <form asp-controller="Password" asp-action="ForgotPassword" method="post" novalidate>
                    <div asp-validation-summary="All" class="server-alert"></div>

                    <div class="field">
                        <label asp-for="Email">E-posta</label>
                        <div class="input-wrap">
                            <i class="bi bi-envelope lead"></i>
                            <input class="a-input" asp-for="Email" type="email" placeholder="ad.soyad@ornek.com"
                                   autocomplete="email" spellcheck="false" autocapitalize="none" autofocus>
                        </div>
                    </div>

                    <button type="submit" class="btn-primary-x">
                        <span class="lbl">Bağlantı Gönder</span><i class="bi bi-send"></i>
                    </button>
                </form>

                <div class="form-foot">Şifrenizi hatırladınız mı? <a asp-controller="Login" asp-action="SignIn">Giriş Yap</a></div>
            </section>
        </div>
    </main>

</body>
</html>