@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
    ViewData["ActiveMenu"] = "settings";
    Layout = "~/Views/MessageLayout/Index.cshtml";

    // Alanda sunucu hatası varsa tema sınıfı "has-error" eklenir
    string ErrClass(string key) =>
        ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0 ? "has-error" : "";
}

<style>
    .pw-page { max-width: 640px; margin: 0 auto; }
    .pw-alert { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: 12px; font-size: 13px; font-weight: 600; margin-bottom: 18px; background: var(--mint); color: #3E9A77; }
</style>

<div class="profile pw-page">
    <div class="pf-head">
        <h1>Şifre Değiştir</h1>
        <p>Hesabınızın güvenliği için şifrenizi düzenli aralıklarla güncelleyin.</p>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="pw-alert"><i class="bi bi-check2-circle"></i><span>@successMessage</span></div>
    }

    <form class="pf-card" asp-controller="Password" asp-action="ChangePassword" method="post" novalidate>
        <div class="pf-card-head">
            <div class="ic av-lav"><i class="bi bi-shield-lock"></i></div>
            <div>
                <h3>Güvenlik</h3>
                <p>Önce mevcut şifrenizi, ardından yeni şifrenizi girin.</p>
            </div>
        </div>

        <div class="pf-card-body">
            <div class="pf-form-grid">
                <div class="pf-field span-2 @ErrClass(nameof(ChangePasswordViewModel.CurrentPassword))">
                    <label asp-for="CurrentPassword">Mevcut Şifre <span class="req">*</span></label>
                    <div class="pf-input-wrap">
                        <i class="bi bi-key lead"></i>
                        <input class="pf-input has-eye" asp-for="CurrentPassword" type="password" autocomplete="current-password">
                        <button type="button" class="icon-btn pf-eye" data-eye="CurrentPassword" title="Şifreyi göster"><i class="bi bi-eye"></i></button>
                    </div>
                    <span class="pf-error" asp-validation-for="CurrentPassword"></span>
                </div>

                <div class="pf-field span-2 @ErrClass(nameof(ChangePasswordViewModel.NewPassword))">
                    <label asp-for="NewPassword">Yeni Şifre <span class="req">*</span></label>
                    <div class="pf-input-wrap">
                        <i class="bi bi-lock lead"></i>
                        <input class="pf-input has-eye" asp-for="NewPassword" type="password" autocomplete="new-password">
                        <button type="button" class="icon-btn pf-eye" data-eye="NewPassword" title="Şifreyi göster"><i class="bi bi-eye"></i></button>
                    </div>
                    <div class="pf-hint"><span>En az 8 karakter; büyük harf, küçük harf, rakam ve özel karakter.</span></div>
                    <span class="pf-error" asp-validation-for="NewPassword"></span>
                </div>

                <div class="pf-field span-2 @ErrClass(nameof(ChangePasswordViewModel.ConfirmPassword))">
                    <label asp-for="ConfirmPassword">Yeni Şifre Tekrar <span class="req">*</span></label>
                    <div class="pf-input-wrap">
                        <i class="bi bi-shield-check lead"></i>
                        <input class="pf-input has-eye" asp-for="ConfirmPassword" type="password" autocomplete="new-password">
                        <button type="button" class="icon-btn pf-eye" data-eye="ConfirmPassword" title="Şifreyi göster"><i class="bi bi-eye"></i></button>
                    </div>
                    <span class="pf-error" asp-validation-for="ConfirmPassword"></span>
                </div>
            </div>
        </div>

        <div class="pf-card-foot">
            <span class="pf-lastpw"><i class="bi bi-info-circle"></i> Şifre değişince diğer cihazlardaki oturumlarınız kapanır.</span>
            <button type="submit" class="btn-send"><i class="bi bi-check2"></i> Şifreyi Güncelle</button>
        </div>
    </form>
</div>

<script>
    // Şifre göster / gizle
    document.querySelectorAll('[data-eye]').forEach(btn => btn.addEventListener('click', () => {
        const input = document.getElementById(btn.dataset.eye);
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        btn.title = show ? 'Şifreyi gizle' : 'Şifreyi göster';
    }));
</script>