@model NavbarUserViewModel

<!-- =====================================================================
        SHARED NAVBAR
        Kullanıcı bilgileri çerezdeki claim'lerden gelir (veritabanı sorgusu yok).
        ===================================================================== -->
<style>
    /* [hidden] özelliği, display'i belirleyen bir CSS kuralı varsa ezilir: garantiye al (12.6) */
    .pip[hidden], .notif-desktop[hidden] {
        display: none !important;
    }

    .notif-desktop {
        width: 100%;
        margin: 4px 0 6px;
        border: 1px dashed var(--border);
        background: var(--bg);
        border-radius: 10px;
        padding: 8px 10px;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--accent-dark);
        text-align: left;
    }

        .notif-desktop:hover {
            border-color: var(--accent);
        }
</style>

<header class="app-navbar">
    <button class="nav-toggle" id="sidebarToggle" type="button" aria-label="Menüyü daralt / genişlet" title="Menüyü daralt"><i class="bi bi-list"></i></button>

    <div class="global-search">
        <i class="bi bi-search"></i>
        <input type="search" id="globalSearch" placeholder="Mesajlarda, kişilerde ara…" autocomplete="off">
        <span class="kbd">Ctrl K</span>
    </div>

    <div class="nav-actions">
        <!-- Bildirimler: son 5 okunmamış mesaj. Adresler mailora-notify.js içindir (12.6). -->
        <div class="dropdown" id="notifBell"
             data-check-url="@Url.Action("Check", "Notifications")"
             data-menu-url="@Url.Action("Menu", "Notifications")">
            <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Bildirimler">
                <i class="bi bi-bell"></i>
                @* Her zaman çizilir; görünürlüğü JS günceller (yeni mesaj geldiğinde ya da okundu yapıldığında) *@
                <span class="pip" id="notifPip" hidden="@(!Model.Notifications.Any())"></span>
            </button>
            <div class="dropdown-menu dropdown-menu-end notif-menu">
                <div class="d-flex justify-content-between align-items-center px-2 pt-1 pb-2">
                    <strong style="font-size:14px">Okunmamış Mesajlar</strong>
                    <a asp-controller="Message" asp-action="Inbox" style="font-size:12.5px;font-weight:600;color:var(--accent)">Tümünü gör</a>
                </div>

                @* Masaüstü bildirimi izni: sadece izin HENÜZ sorulmadıysa JS gösterir (karar 3-B) *@
                <button type="button" class="notif-desktop" id="notifDesktop" hidden>
                    <i class="bi bi-bell"></i> Masaüstü bildirimlerini aç
                </button>

                <div id="notifList">
                    <partial name="_NotificationList" model="Model.Notifications" />
                </div>
            </div>
        </div>

        <div class="dropdown">
            <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <partial name="_Avatar" model='new AvatarViewModel(Model.FullName, Model.Email, Model.PhotoFile)' />
                <span class="meta">
                    <span class="name d-block">@Model.FullName</span>
                    <span class="role d-block">@Model.Email</span>
                </span>
                <i class="bi bi-chevron-down"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li class="dd-head">
                    <partial name="_Avatar" model='new AvatarViewModel(Model.FullName, Model.Email, Model.PhotoFile)' />
                    <div style="min-width:0">
                        <div style="font-weight:700">@Model.FullName</div>
                        <div style="font-size:12.5px;color:var(--muted)">@Model.Email</div>
                    </div>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person"></i> Profilim</a></li>
                <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i> Ayarlar</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-controller="Login" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item danger"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>
<!-- /SHARED NAVBAR -->