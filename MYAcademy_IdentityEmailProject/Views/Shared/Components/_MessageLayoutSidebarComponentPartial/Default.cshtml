<!-- =====================================================================
      SHARED SIDEBAR
      Linkler tag helper ile üretilir: hedef action henüz yoksa href boş kalır,
      action yazıldığında link kendiliğinden çalışır.
      ===================================================================== -->
<aside class="app-sidebar" id="appSidebar" aria-label="Ana menü">
    <a class="brand" asp-controller="Home" asp-action="Index">
        <div class="brand-logo"><i class="bi bi-envelope-paper-heart-fill"></i></div>
        <div class="brand-name">Mail<span>ora</span></div>
    </a>

    <a class="btn-compose" asp-controller="Message" asp-action="CreateMessage" data-page="compose" data-tip="Yeni Mesaj">
        <i class="bi bi-pencil-square"></i> <span class="lbl">Yeni Mesaj</span>
    </a>

    <div class="nav-section-title">Menü</div>
    <ul class="side-nav">
        <li><a class="side-link" data-page="dashboard" asp-controller="Dashboard" asp-action="Index" data-tip="Dashboard"><i class="bi bi-grid-1x2"></i> <span class="lbl">Dashboard</span></a></li>
        <li><a class="side-link" data-page="inbox" asp-controller="Message" asp-action="Inbox" data-tip="Gelen Kutusu"><i class="bi bi-inbox"></i> <span class="lbl">Gelen Kutusu</span> <span class="side-badge" id="badgeInbox">@(Model.Counts.UnreadInbox > 0 ? Model.Counts.UnreadInbox.ToString() : "")</span></a></li>
        <li><a class="side-link" data-page="sent" asp-controller="Message" asp-action="Sent" data-tip="Gönderilenler"><i class="bi bi-send"></i> <span class="lbl">Gönderilenler</span></a></li>
        <li><a class="side-link" data-page="drafts" asp-controller="Message" asp-action="Drafts" data-tip="Taslaklar"><i class="bi bi-file-earmark-text"></i> <span class="lbl">Taslaklar</span> <span class="side-badge muted" id="badgeDrafts">@(Model.Counts.Drafts > 0 ? Model.Counts.Drafts.ToString() : "")</span></a></li>
        <li><a class="side-link" data-page="starred" asp-controller="Message" asp-action="Starred" data-tip="Yıldızlı Mesajlar"><i class="bi bi-star"></i> <span class="lbl">Yıldızlı Mesajlar</span> <span class="side-badge muted" id="badgeStarred">@(Model.Counts.Starred > 0 ? Model.Counts.Starred.ToString() : "")</span></a></li>
        <li><a class="side-link" data-page="trash" asp-controller="Message" asp-action="Trash" data-tip="Çöp Kutusu"><i class="bi bi-trash3"></i> <span class="lbl">Çöp Kutusu</span> <span class="side-badge muted" id="badgeTrash">@(Model.Counts.Trash > 0 ? Model.Counts.Trash.ToString() : "")</span></a></li>
    </ul>

    <div class="nav-section-title">Hesap</div>
    <ul class="side-nav">
        <li><a class="side-link" data-page="profile" asp-controller="Profile" asp-action="Index" data-tip="Profilim"><i class="bi bi-person-circle"></i> <span class="lbl">Profilim</span></a></li>
        <li><a class="side-link" data-page="settings" asp-controller="Password" asp-action="ChangePassword" data-tip="Ayarlar"><i class="bi bi-gear"></i> <span class="lbl">Ayarlar</span></a></li>
    </ul>

    <div class="nav-section-title">Etiketler</div>
    <ul class="side-labels">
        @foreach (var category in Model.Categories)
        {
            <li>
                <a asp-controller="Message" asp-action="Inbox" asp-route-categoryId="@category.CategoryId" data-tip="@category.CategoryName">
                    <span class="dot" style="background:@category.ColorCode"></span>
                    <span class="lbl">@category.CategoryName</span>
                </a>
            </li>
        }
    </ul>
</aside>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
<!-- /SHARED SIDEBAR -->