@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_MessageLayoutStyleComponentPartial")

<body class="preload"
      data-title="@ViewData["Title"]"
      data-active-menu="@ViewData["ActiveMenu"]"
      data-inbox-url="@(Url.Action("Inbox", "Message") ?? "/Message/Inbox")"
      data-star-url="@Url.Action("SetStar", "Message")">

    @await Component.InvokeAsync("_MessageLayoutSidebarComponentPartial")

    @await Component.InvokeAsync("_MessageLayoutHeaderComponentPartial")

    <!-- =====================================================================
         DİNAMİK İÇERİK — her View (Inbox/Index.cshtml …) burayı doldurur
         ===================================================================== -->
    <main class="app-main page-enter" id="mainContent">
        @RenderBody()
    </main>

    <div class="toast-stack" id="toastStack"></div>

    @* fetch istekleri için antiforgery token (7.6). JavaScript buradan okuyup başlıkta gönderir. *@
    @Html.AntiForgeryToken()

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            /* ======================================================================
               MAILORA LAYOUT — yalnızca tüm sayfalarda ortak olan davranışlar:
               toast, sidebar (daralt / mobil menü), aktif menü, rozetler,
               global arama ve etiket kısayolları.
               Sayfalar bu fonksiyonlara window.Mailora üzerinden erişir.
               ====================================================================== */
            (() => {
                const SIDEBAR_KEY = 'mailora.sidebarCollapsed';
                const body = document.body;
                const INBOX_URL = body.dataset.inboxUrl || '/Message/Inbox';

                /* --- Yardımcılar --- */
                const $ = (sel, root = document) => root.querySelector(sel);
                const $$ = (sel, root = document) => [...root.querySelectorAll(sel)];
                const readJSON = k => { try { return JSON.parse(localStorage.getItem(k)); } catch (e) { return null; } };
                const writeJSON = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); return true; } catch (e) { return false; } };
                const escapeHtml = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

                /* --- Toast bildirimi --- */
                function showToast(text, icon = 'bi-check2-circle', action) {
                    const stack = $('#toastStack');
                    if (!stack) return;
                    const el = document.createElement('div');
                    el.className = 'm-toast';
                    el.innerHTML = `<i class="bi ${icon} lead-ic"></i><span>${text}</span>`;
                    const close = () => { el.classList.add('out'); setTimeout(() => el.remove(), 250); };
                    if (action) {
                        const b = document.createElement('button');
                        b.type = 'button';
                        b.textContent = action.label;
                        b.onclick = () => { action.onClick(); close(); };
                        el.appendChild(b);
                    }
                    stack.appendChild(el);
                    setTimeout(close, action ? 5000 : 2800);
                }

                /* --- Sidebar rozetleri (ör. setBadge('badgeInbox', 4)) --- */
                function setBadge(id, n) {
                    const el = document.getElementById(id);
                    if (el) el.textContent = n ? n : '';
                }

                /* --- Sunucuya POST (fetch) — 7.6 ---
                   Antiforgery token sayfadaki gizli alandan okunur ve başlıkta gönderilir.
                   Oturum sona ermişse sunucu 401 döner (Aşama 3.5): sayfa yenilenir, 401 kartı açılır. */
                async function post(url, data = {}) {
                    const token = $('input[name="__RequestVerificationToken"]')?.value ?? '';

                    // Dizi değerler aynı anahtarla tekrarlanır: { ids: [4, 7] } → ids=4&ids=7 → int[] ids (7.7)
                    const form = new URLSearchParams();
                    Object.entries(data).forEach(([key, value]) =>
                        [].concat(value).forEach(v => form.append(key, v)));

                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: form
                    });
                    if (response.status === 401) {
                        showToast('Oturumunuz sona erdi. Yönlendiriliyorsunuz…', 'bi-box-arrow-in-right');
                        setTimeout(() => location.reload(), 1500);
                        throw new Error('401');
                    }
                    if (!response.ok) throw new Error(String(response.status));

                    // Sunucu güncel sayaçları gönderdiyse sidebar'ı güncelle (7.8) ve
                    // sayfalara "bir şey değişti" olayını yayınla. Layout sayfaları tanımaz; sayfalar dinler.
                    const result = await response.json();
                    if (result && result.counts) applyCounts(result.counts);
                    document.dispatchEvent(new CustomEvent('mailora:changed', { detail: result }));
                    return result;
                }

                /* --- Sidebar sayaçları: tek doğruluk kaynağı sunucu (7.8) --- */
                function applyCounts(counts) {
                    setBadge('badgeInbox', counts.unreadInbox);
                    setBadge('badgeDrafts', counts.drafts);
                    setBadge('badgeStarred', counts.starred);
                    setBadge('badgeTrash', counts.trash);
                }

                /* --- Yıldızlama (tüm sayfalar): <button data-star data-id="MailboxItemId"> — 7.6 ---
                   Olay yetkilendirmesi: tek dinleyici, sayfadaki bütün yıldız butonlarını yönetir.
                   İyimser güncelleme: arayüz hemen değişir, sunucu reddederse geri alınır. */
                const STAR_URL = body.dataset.starUrl;

                function paintStar(btn, on) {
                    btn.classList.toggle('on', on);
                    btn.querySelector('i').className = on ? 'bi bi-star-fill' : 'bi bi-star';
                    btn.setAttribute('aria-label', on ? 'Yıldızı kaldır' : 'Yıldızla');
                }

                document.addEventListener('click', async e => {
                    const btn = e.target.closest('[data-star]');
                    if (!btn || !STAR_URL) return;
                    e.preventDefault();

                    const next = !btn.classList.contains('on');
                    paintStar(btn, next);                                     // 1) hemen göster
                    btn.classList.add('pop');
                    setTimeout(() => btn.classList.remove('pop'), 350);

                    try {
                        await post(STAR_URL, { id: btn.dataset.id, isStarred: next });   // 2) sunucuya bildir
                        showToast(next ? 'Mesaj yıldızlandı.' : 'Yıldız kaldırıldı.', next ? 'bi-star-fill' : 'bi-star');
                    } catch (err) {
                        paintStar(btn, !next);                                // 3) başarısızsa geri al
                        if (err.message !== '401') showToast('İşlem kaydedilemedi.', 'bi-exclamation-circle');
                    }
                });

                /* --- Sayfa başlığı & aktif menü (ViewData["Title"], ViewData["ActiveMenu"]) --- */
                if (body.dataset.title) document.title = `${body.dataset.title} · Mailora`;
                const activeMenu = body.dataset.activeMenu;
                if (activeMenu) {
                    $$('.side-link').forEach(a =>
                        a.classList.toggle('active', a.dataset.menu === activeMenu || a.dataset.page === activeMenu));
                }

                /* --- Sidebar: masaüstünde daralt, tablet & mobilde açılır menü --- */
                const openSidebar = () => body.classList.add('sidebar-open');
                const closeSidebar = () => body.classList.remove('sidebar-open');

                function setSidebarCollapsed(on, persist = true) {
                    body.classList.toggle('sidebar-collapsed', on);
                    const t = $('#sidebarToggle');
                    if (t) {
                        t.title = on ? 'Menüyü genişlet' : 'Menüyü daralt';
                        t.setAttribute('aria-expanded', String(!on));
                    }
                    if (persist) writeJSON(SIDEBAR_KEY, on);
                }

                $('#sidebarToggle')?.addEventListener('click', () => {
                    if (window.innerWidth >= 992) setSidebarCollapsed(!body.classList.contains('sidebar-collapsed'));
                    else openSidebar();
                });
                $('#sidebarBackdrop')?.addEventListener('click', closeSidebar);
                window.addEventListener('resize', () => { if (window.innerWidth >= 992) closeSidebar(); });

                /* --- Global arama (Navbar) ---
                   Gelen Kutusu açıksa anlık filtreler, değilse Enter ile Gelen Kutusu'nda arar. */
                const globalSearch = $('#globalSearch');
                if (globalSearch) {
                    globalSearch.addEventListener('input', e => {
                        if (typeof window.Mailora.onSearch === 'function') window.Mailora.onSearch(e.target.value);
                    });
                    globalSearch.addEventListener('keydown', e => {
                        if (e.key !== 'Enter' || typeof window.Mailora.onSearch === 'function') return;
                        e.preventDefault();
                        const q = globalSearch.value.trim();
                        location.href = q ? `${INBOX_URL}?q=${encodeURIComponent(q)}` : INBOX_URL;
                    });
                }

                /* --- Genel klavye kısayolları --- */
                document.addEventListener('keydown', e => {
                    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); globalSearch?.focus(); }
                    if (e.key === 'Escape') closeSidebar();
                });

                /* --- Sayfaların kullanacağı ortak API --- */
                window.Mailora = {
                    $, $$, escapeHtml, showToast, setBadge, openSidebar, closeSidebar, post, applyCounts,
                    inboxUrl: INBOX_URL,
                    onSearch: null,   // sayfa arama yapabiliyorsa kendi fonksiyonunu atar
                    onLabel: null     // sayfa etiket filtresi destekliyorsa kendi fonksiyonunu atar
                };

                /* --- Başlangıç --- */
                setSidebarCollapsed(readJSON(SIDEBAR_KEY) === true, false);
                requestAnimationFrame(() => requestAnimationFrame(() => body.classList.remove('preload')));
            })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>