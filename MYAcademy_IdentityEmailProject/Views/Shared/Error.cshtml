@model ErrorViewModel
@{
    Layout = "_ErrorLayout";
    ViewData["Title"] = "Beklenmeyen Hata";
}

<div class="error-icon"><i class="bi bi-exclamation-triangle"></i></div>
<div class="error-code">500</div>
<h1>Beklenmeyen bir hata oluştu</h1>
<p>İsteğiniz işlenirken bir sorun yaşandı. Lütfen biraz sonra tekrar deneyin.</p>

<div class="error-actions">
    <a class="btn-primary-x" asp-controller="Home" asp-action="Index">
        <span class="lbl">Ana Sayfaya Dön</span><i class="bi bi-arrow-right"></i>
    </a>
</div>

@if (Model.ShowRequestId)
{
    <div class="error-meta">Hata kimliği: <code>@Model.RequestId</code></div>
}