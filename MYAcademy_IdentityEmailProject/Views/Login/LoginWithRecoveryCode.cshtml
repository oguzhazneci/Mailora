@model LoginWithRecoveryCodeViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_RegisterStyleComponentPartial", new { title = "Kurtarma Kodu" })
<body>

    <div class="auth-bg" aria-hidden="true"><span class="g1"></span><span class="g2"></span><span class="g3"></span></div>

    <main class="auth-page">
        <div class="auth-card">

            @await Component.InvokeAsync("_RegisterBrandComponentPartial")

            <section class="auth-form-wrap">
                <div class="form-head">
                    <h1>Kurtarma Kodu</h1>
                    <p>İki adımlı doğrulamayı açarken kaydettiğiniz kodlardan birini girin. Her kod yalnızca bir kez kullanılabilir.</p>
                </div>

                <partial name="_AuthMessages" />

                <form asp-controller="Login" asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate autocomplete="off">
                    <div asp-validation-summary="All" class="server-alert"></div>

                    <div class="form-grid">
                        <div class="field span-2">
                            <label asp-for="RecoveryCode">Kurtarma kodu</label>
                            <div class="input-wrap">
                                <i class="bi bi-key lead"></i>
                                <input class="a-input" asp-for="RecoveryCode" type="text" placeholder="XXXXX-XXXXX" maxlength="20"
                                       spellcheck="false" autocapitalize="characters" autofocus>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn-primary-x">
                        <span class="lbl">Giriş Yap</span><i class="bi bi-arrow-right"></i>
                    </button>

                    <div class="form-foot"><a asp-action="LoginWith2fa" asp-route-returnUrl="@ViewBag.ReturnUrl">Authenticator koduyla giriş yapın</a></div>
                </form>
            </section>
        </div>
    </main>
</body>
</html>