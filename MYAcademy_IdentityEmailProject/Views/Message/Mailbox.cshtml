@model MailboxViewModel
@using System.Globalization
@using System.Net
@using System.Text.RegularExpressions
@using MYAcademy_IdentityEmailProject.Entities
@{
    // Başlık, aktif menü ve linklerin action'ı görünüm tanımından gelir (9.2)
    ViewData["Title"] = Model.Title;
    ViewData["ActiveMenu"] = Model.ActiveMenu;
    Layout = "_MessageLayout";

    var activeCategory = Model.Categories.FirstOrDefault(c => c.CategoryId == Model.Query.CategoryId);
    bool hasSearch = !string.IsNullOrWhiteSpace(Model.Query.Q);
    bool isFiltered = hasSearch || activeCategory != null || Model.Query.Filter != MailboxFilter.All;

    int firstRow = Model.TotalItems == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    int lastRow = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);
}
@functions {
    static readonly CultureInfo Tr = new("tr-TR");

    static string DisplayName(AppUser user)
    {
        var fullName = $"{user.Name} {user.Surname}".Trim();
        return fullName.Length > 0 ? fullName : (user.Email ?? "Bilinmeyen gönderen");
    }

    // Satırda gösterilecek "karşı taraf" (9.3). Yön, görünümden değil satırın KLASÖRÜNDEN gelir:
    // Gelen kopyada gönderen, Gönderilen/Taslak kopyada alıcı(lar). Yıldızlı ve Çöp Kutusu karışık listelerdir.
    // Photo: karşı tarafın avatar dosyası (10.4). Gönderen Include ile zaten yüklü; alıcıların fotoğrafı
    // adlarıyla aynı tek sorgudan (UserPhotos) gelir — ek sorgu yok.
    (string Label, string Name, string? Key, string? Photo) Counterpart(MailboxItem item)
    {
        var msg = item.Message;
        if (item.Folder == MailFolder.Inbox)
            return ("", DisplayName(msg.Sender), msg.Sender.Email, msg.Sender.ImageUrl);

        var recipients = msg.Recipients.OrderBy(r => r.RecipientType).ToList();
        if (recipients.Count == 0)
            return ("Kime: ", "Alıcı yok", null, null);

        var first = recipients[0];
        // Kayıtlı alıcının adı controller'ın tek sorguyla doldurduğu sözlükten; dış alıcıda adres
        string name = first.UserId != null && Model.UserNames.TryGetValue(first.UserId, out var n) ? n : first.Email;
        string? photo = first.UserId != null && Model.UserPhotos.TryGetValue(first.UserId, out var f) ? f : null;
        string more = recipients.Count > 1 ? $" +{recipients.Count - 1}" : "";
        return ("Kime: ", name + more, first.Email, photo);
    }

    // HTML içerikten tek satırlık düz metin özet
    static string Snippet(string? html, int max = 140)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        var text = WebUtility.HtmlDecode(Regex.Replace(html, "<[^>]+>", " "));
        text = Regex.Replace(text, @"\s+", " ").Trim();
        return text.Length > max ? text[..max].TrimEnd() + "…" : text;
    }

    // Bugün → 10:42 · Dün → Dün · Bu yıl → 4 Kas · Eski → 12.03.2025
    static string ShortTime(DateTime d)
    {
        var today = DateTime.Today;
        if (d.Date == today) return d.ToString("HH:mm", Tr);
        if (d.Date == today.AddDays(-1)) return "Dün";
        if (d.Year == today.Year) return d.ToString("d MMM", Tr);
        return d.ToString("dd.MM.yyyy", Tr);
    }
}

<style>
    /* Tema sayfalama stillerini <button> için tanımlamış; aynı görünümü linklere veriyoruz. */
    .pager a, .pager span {
        min-width: 30px;
        height: 30px;
        border-radius: 9px;
        color: #5D6075;
        font-weight: 600;
        font-size: 12.5px;
        display: grid;
        place-items: center;
        padding: 0 6px;
        transition: background .2s;
    }

        .pager a:hover {
            background: var(--lavender);
            color: var(--accent-dark);
        }

        .pager a.active {
            background: var(--accent);
            color: #fff;
        }

        .pager span.disabled {
            opacity: .35;
        }

    .list-select {
        height: 34px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: #fff;
        font-size: 12.5px;
        font-weight: 600;
        color: #5D6075;
        padding: 0 10px;
    }

    .empty-list a {
        color: var(--accent);
        font-weight: 600;
    }

    /* Başlığın sağ tarafı: okunmamış rozeti + (Çöp Kutusu'nda) Çöpü Boşalt — 9.5 */
    .list-title-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .list-title-actions form {
            margin: 0;
        }

    .btn-empty-trash {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 30px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, #C2476B 25%, white);
        background: color-mix(in srgb, #C2476B 8%, white);
        color: #C2476B;
        font-size: 12.5px;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
        transition: background .2s;
    }

        .btn-empty-trash:hover:not(:disabled) {
            background: color-mix(in srgb, #C2476B 15%, white);
        }

        .btn-empty-trash:disabled {
            opacity: .45;
            cursor: not-allowed;
        }
</style>

<section class="inbox" id="inbox">
    <div class="panel list-panel">

        <!-- Başlık, arama, sıralama, kategori ve filtre çipleri -->
        <div class="list-head">
            <div class="list-title">
                <div>
                    <h1>@Model.Title</h1>
                    <div class="sub" id="inboxSub" data-suffix="@(hasSearch || activeCategory != null ? " · filtrelenmiş" : "")">@Model.AllCount mesaj@(hasSearch || activeCategory != null ? " · filtrelenmiş" : "")</div>
                </div>
                @* Sağdaki öğeler tek grupta: başlık satırı "sol blok | sağ grup" olarak iki parçada kalır *@
                <div class="list-title-actions">
                    @if (Model.TracksReadState)
                    {
                        <span class="count-pill" id="unreadPill">@Model.UnreadCount okunmamış</span>
                    }
                    @if (Model.IsTrash)
                    {
                        @* Normal form POST → sunucu siler → Redirect → GET (PRG). F5 silmeyi tekrarlamaz. *@
                        <form method="post" asp-controller="Message" asp-action="EmptyTrash"
                              onsubmit="return confirm('Çöp kutusundaki TÜM mesajlar kalıcı olarak silinecek. Bu işlem geri alınamaz. Devam edilsin mi?');">
                            <button type="submit" class="btn-empty-trash" disabled="@(Model.AllCount == 0 && !isFiltered)">
                                <i class="bi bi-trash3"></i> Çöpü Boşalt
                            </button>
                        </form>
                    }
                </div>
            </div>

            <form method="get" asp-controller="Message" asp-action="@Model.ActionName" class="list-tools">
                @* Aktif durum filtresi arama yapınca kaybolmasın (7.4, Kavram 2) *@
                @if (Model.Query.Filter != MailboxFilter.All)
                {
                    <input type="hidden" name="filter" value="@Model.Query.Filter" />
                }

                <div class="list-search @(hasSearch ? "has-value" : "")">
                    <i class="bi bi-search"></i>
                    <input type="text" name="q" value="@Model.Query.Q" placeholder="@Model.SearchPlaceholder" autocomplete="off">
                    @if (hasSearch)
                    {
                        <a class="clear" asp-action="@Model.ActionName" asp-all-route-data="Model.RouteWith(clearSearch: true)" aria-label="Aramayı temizle"><i class="bi bi-x-circle-fill"></i></a>
                    }
                </div>

                <select name="categoryId" class="list-select" data-autosubmit aria-label="Kategori">
                    <option value="">Tüm kategoriler</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.CategoryId" selected="@(category.CategoryId == Model.Query.CategoryId)">@category.CategoryName</option>
                    }
                </select>

                <select name="sort" class="list-select" data-autosubmit aria-label="Sıralama">
                    <option value="Newest" selected="@(Model.Query.Sort == MailboxSort.Newest)">Yeniden eskiye</option>
                    <option value="Oldest" selected="@(Model.Query.Sort == MailboxSort.Oldest)">Eskiden yeniye</option>
                </select>

                <div class="filter-chips">
                    <a class="chip @(Model.Query.Filter == MailboxFilter.All ? "active" : "")"
                       asp-action="@Model.ActionName" asp-all-route-data="Model.RouteWith(filter: MailboxFilter.All)">Tümü <span class="n" id="countAll">@Model.AllCount</span></a>
                    @if (Model.TracksReadState)
                    {
                        <a class="chip @(Model.Query.Filter == MailboxFilter.Unread ? "active" : "")"
                           asp-action="@Model.ActionName" asp-all-route-data="Model.RouteWith(filter: MailboxFilter.Unread)">Okunmamış <span class="n" id="countUnread">@Model.UnreadCount</span></a>
                    }
                    @if (Model.ShowsStarFilter)
                    {
                        <a class="chip @(Model.Query.Filter == MailboxFilter.Starred ? "active" : "")"
                           asp-action="@Model.ActionName" asp-all-route-data="Model.RouteWith(filter: MailboxFilter.Starred)">Yıldızlı <span class="n" id="countStarred">@Model.StarredCount</span></a>
                    }
                    @if (activeCategory != null)
                    {
                        <a class="chip active" asp-action="@Model.ActionName" asp-all-route-data="Model.RouteWith(clearCategory: true)" title="Kategori filtresini kaldır">
                            <i class="bi bi-tag-fill"></i> @activeCategory.CategoryName <i class="bi bi-x"></i>
                        </a>
                    }
                </div>
            </form>
        </div>

        <!-- Toplu işlemler (7.7): seçim bu sayfadaki satırlarla sınırlı -->
        <div class="bulk-bar" id="bulkBar"
             data-read-url="@Url.Action("BulkSetRead", "Message")"
             data-trash-url="@Url.Action("BulkMoveToTrash", "Message")"
             data-restore-url="@Url.Action("BulkRestore", "Message")"
             data-forever-url="@Url.Action("BulkDeleteForever", "Message")"
             data-archive-url="@Url.Action("BulkArchive", "Message")"
             data-unarchive-url="@Url.Action("BulkUnarchive", "Message")"
             data-counts-url="@Url.Action("ListCounts", "Message", new { view = Model.View })">
            <input type="checkbox" class="m-check" id="checkAll" aria-label="Bu sayfadakilerin tümünü seç" disabled="@(!Model.Items.Any())">
            <span class="sel-info" id="selInfo">Tümünü seç</span>
            <span class="spacer"></span>
            @if (Model.TracksReadState)
            {
                <button type="button" class="tool-btn" data-bulk="read" title="Okundu olarak işaretle" disabled><i class="bi bi-envelope-open"></i></button>
                <button type="button" class="tool-btn" data-bulk="unread" title="Okunmadı olarak işaretle" disabled><i class="bi bi-envelope"></i></button>
            }
            @if (Model.IsTrash)
            {
                @* Çöp Kutusu'nda "çöpe taşı" yerine: geri al ve kalıcı sil (9.5) *@
                <button type="button" class="tool-btn" data-bulk="restore" title="Geri al" disabled><i class="bi bi-arrow-counterclockwise"></i></button>
                <button type="button" class="tool-btn" data-bulk="forever" title="Kalıcı olarak sil" disabled><i class="bi bi-x-octagon"></i></button>
            }
            else
            {
                @if (Model.CanArchive)
                {
                    <button type="button" class="tool-btn" data-bulk="archive" title="Arşivle" disabled><i class="bi bi-archive"></i></button>
                }
                @if (Model.IsArchive)
                {
                    <button type="button" class="tool-btn" data-bulk="unarchive" title="Gelen Kutusu'na taşı" disabled><i class="bi bi-inbox"></i></button>
                }
                <button type="button" class="tool-btn" data-bulk="trash" title="Çöp kutusuna taşı" disabled><i class="bi bi-trash3"></i></button>
            }
        </div>

        <!-- Mesaj listesi: sadece bu sayfanın satırları sunucudan gelir -->
        <div class="msg-list" id="msgList">
            @foreach (var item in Model.Items)
            {
                var msg = item.Message;                          // içerik (herkes için aynı)
                var who = Counterpart(item);                     // gönderen ya da alıcı (9.3)
                var sentDate = msg.SentDate ?? msg.UpdatedDate;
                // Taslak satırı düzenleme sayfasını açar; çöpteki taslak ise sadece görüntülenir (9.6)
                var detailUrl = item.Folder == MailFolder.Draft && item.DeletedDate == null
                    ? Url.Action("CreateMessage", "Message", new { draftId = msg.MessageId })
                    : Url.Action("Detail", "Message", new { id = msg.MessageId });

                <article class="msg-item @(item.IsRead ? "" : "unread")"
                         data-id="@item.MailboxItemId"
                         data-href="@detailUrl"
                         tabindex="0" title="Mesajı aç">
                    <div class="lead">
                        <input type="checkbox" class="m-check row-check" aria-label="Seç">
                        @* item = benim kopyam: yıldız bilgisi kişiye özel (layout'taki dinleyici, 7.6).
                           Taslaklarda yıldız yok (9.1, karar 2-A) — Çöp Kutusu'ndaki taslaklar dahil. *@
                        @if (item.Folder != MailFolder.Draft)
                        {
                            <button class="star-btn @(item.IsStarred ? "on" : "")" type="button" data-star data-id="@item.MailboxItemId"
                                    aria-label="@(item.IsStarred ? "Yıldızı kaldır" : "Yıldızla")">
                                <i class="bi @(item.IsStarred ? "bi-star-fill" : "bi-star")"></i>
                            </button>
                        }
                    </div>
                    <partial name="_Avatar" model="new AvatarViewModel(who.Name, who.Key, who.Photo)" />
                    <div class="mi-sender">
                        <span class="sender">@(who.Label + who.Name)</span>
                        @if (!item.IsRead)
                        {
                            <span class="unread-dot"></span>
                        }
                    </div>
                    <div class="mi-main">
                        <span class="subject">@(string.IsNullOrWhiteSpace(msg.Subject) ? "(Konu yok)" : msg.Subject)</span>
                        <span class="snippet">@Snippet(msg.Body)</span>
                    </div>
                    <div class="mi-meta">
                        @if (msg.Category != null)
                        {
                            <span class="tag" style="color:@msg.Category.ColorCode;background:color-mix(in srgb, @msg.Category.ColorCode 14%, white)">@msg.Category.CategoryName</span>
                        }
                    </div>
                    <span class="time" title="@(sentDate.ToString("d MMMM yyyy, dddd HH:mm", Tr))">@ShortTime(sentDate)</span>
                </article>
            }

            @if (!Model.Items.Any())
            {
                if (!isFiltered)
                {
                    <div class="empty-list">
                        <div class="ic"><i class="bi @Model.EmptyIcon"></i></div>
                        <h6>@Model.EmptyTitle</h6>
                        <div>@Model.EmptyText</div>
                    </div>
                }
                else
                {
                    <div class="empty-list">
                        <div class="ic"><i class="bi bi-search-heart"></i></div>
                        <h6>Sonuç bulunamadı</h6>
                        <div>Arama veya filtre kriterlerini değiştirin ya da <a asp-action="@Model.ActionName">filtreleri temizleyin</a>.</div>
                    </div>
                }
            }
        </div>

        <!-- Sayfalama -->
        <div class="list-foot">
            <span class="range">@firstRow–@lastRow / @Model.TotalItems mesaj</span>
            @if (Model.TotalPages > 1)
            {
                <nav class="pager" aria-label="Sayfalar">
                    @if (Model.Page > 1)
                    {
                        <a asp-action="@Model.ActionName" asp-all-route-data="Model.RouteWith(page: Model.Page - 1)" aria-label="Önceki sayfa"><i class="bi bi-chevron-left"></i></a>
                    }
                    else
                    {
                        <span class="disabled"><i class="bi bi-chevron-left"></i></span>
                    }

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <a class="@(p == Model.Page ? "active" : "")" asp-action="@Model.ActionName" asp-all-route-data="Model.RouteWith(page: p)">@p</a>
                    }

                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-action="@Model.ActionName" asp-all-route-data="Model.RouteWith(page: Model.Page + 1)" aria-label="Sonraki sayfa"><i class="bi bi-chevron-right"></i></a>
                    }
                    else
                    {
                        <span class="disabled"><i class="bi bi-chevron-right"></i></span>
                    }
                </nav>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const list = document.getElementById('msgList');
            const bar = document.getElementById('bulkBar');
            const checkAll = document.getElementById('checkAll');

            // Sıralama ve kategori seçimi değişince formu gönder.
            document.querySelectorAll('[data-autosubmit]').forEach(select =>
                select.addEventListener('change', () => select.form.submit()));

            // Satıra tıklayınca (buton, link ve kutucuk hariç) mesaj detayını aç.
            list.querySelectorAll('.msg-item').forEach(row => {
                const open = () => { if (row.dataset.href) location.href = row.dataset.href; };
                row.addEventListener('click', e => { if (!e.target.closest('button, a, input')) open(); });
                row.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target === row) open(); });
            });

            /* ---------- Seçim (7.7) ---------- */
            const rows = () => [...list.querySelectorAll('.msg-item')];
            const rowById = id => list.querySelector(`.msg-item[data-id="${id}"]`);
            const selectedIds = () => rows().filter(r => r.querySelector('.row-check').checked).map(r => r.dataset.id);

            function refreshBar() {
                const all = rows();
                const n = selectedIds().length;
                checkAll.checked = all.length > 0 && n === all.length;
                checkAll.indeterminate = n > 0 && n < all.length;
                document.getElementById('selInfo').textContent = n ? `${n} mesaj seçildi` : 'Tümünü seç';
                bar.querySelectorAll('[data-bulk]').forEach(b => b.disabled = n === 0);
                all.forEach(r => r.classList.toggle('checked', r.querySelector('.row-check').checked));
            }

            list.addEventListener('change', e => { if (e.target.matches('.row-check')) refreshBar(); });
            checkAll.addEventListener('change', () => {
                rows().forEach(r => r.querySelector('.row-check').checked = checkAll.checked);
                refreshBar();
            });

            function paintRead(row, isRead) {
                row.classList.toggle('unread', !isRead);
                const sender = row.querySelector('.mi-sender');
                const dot = sender.querySelector('.unread-dot');
                if (isRead && dot) dot.remove();
                if (!isRead && !dot) sender.insertAdjacentHTML('beforeend', '<span class="unread-dot"></span>');
            }

            /* ---------- Bu sayfanın sayaçları (7.8) ----------
               Sidebar rozetlerini layout günceller (yanıttaki counts). Buradaki sayılar ise
               aktif kategori/arama kapsamına göre: aynı adres parametreleriyle sunucudan istenir. */
            async function refreshScopedCounts() {
                try {
                    // countsUrl zaten "?view=Inbox" içeriyor: sayfanın parametrelerini ikinci bir "?" ile
                    // eklemek yerine URL nesnesine tek tek ekliyoruz (9.2).
                    const url = new URL(bar.dataset.countsUrl, location.origin);
                    new URLSearchParams(location.search).forEach((value, key) => url.searchParams.set(key, value));
                    const response = await fetch(url);
                    if (!response.ok) return;
                    const c = await response.json();
                    // Okunmamış çipi ve rozeti her klasörde yok (9.3): eleman varsa güncelle
                    const set = (id, text) => { const el = document.getElementById(id); if (el) el.textContent = text; };
                    set('countAll', c.all);
                    set('countUnread', c.unread);
                    set('countStarred', c.starred);
                    set('unreadPill', `${c.unread} okunmamış`);
                    const sub = document.getElementById('inboxSub');
                    sub.textContent = `${c.all} mesaj${sub.dataset.suffix}`;
                } catch {
                    // Sayaçlar bir sonraki sayfa yüklemesinde zaten doğru gelir.
                }
            }

            // Layout her başarılı POST'tan sonra bu olayı yayınlar (yıldızlama dahil).
            document.addEventListener('mailora:changed', refreshScopedCounts);

            /* ---------- Toplu işlemler (7.7) ---------- */
            bar.addEventListener('click', async e => {
                const btn = e.target.closest('[data-bulk]');
                if (!btn) return;
                const ids = selectedIds();
                if (!ids.length) return;

                try {
                    if (btn.dataset.bulk === 'trash') {
                        const result = await Mailora.post(bar.dataset.trashUrl, { ids });
                        ids.forEach(id => rowById(id)?.remove());
                        refreshBar();
                        Mailora.showToast(`${result.count} mesaj çöp kutusuna taşındı.`, 'bi-trash3', {
                            label: 'Geri al',
                            onClick: async () => {
                                await Mailora.post(bar.dataset.restoreUrl, { ids });
                                location.reload();
                            }
                        });
                        // Sayfada satır kalmadıysa bir sonraki sayfanın mesajlarını getirmek için yenile.
                        if (!rows().length) setTimeout(() => location.reload(), 5200);
                    } else if (btn.dataset.bulk === 'archive') {
                        // Gelen Kutusu → Arşiv (12.2). Geri alınabilir işlem: onay yok, toast'ta "Geri al"
                        const result = await Mailora.post(bar.dataset.archiveUrl, { ids });
                        ids.forEach(id => rowById(id)?.remove());
                        refreshBar();
                        Mailora.showToast(`${result.count} mesaj arşivlendi.`, 'bi-archive', {
                            label: 'Geri al',
                            onClick: async () => {
                                await Mailora.post(bar.dataset.unarchiveUrl, { ids });
                                location.reload();
                            }
                        });
                        if (!rows().length) setTimeout(() => location.reload(), 5200);
                    } else if (btn.dataset.bulk === 'unarchive') {
                        // Arşiv → Gelen Kutusu
                        const result = await Mailora.post(bar.dataset.unarchiveUrl, { ids });
                        ids.forEach(id => rowById(id)?.remove());
                        refreshBar();
                        Mailora.showToast(`${result.count} mesaj Gelen Kutusu'na taşındı.`, 'bi-inbox', {
                            label: 'Geri al',
                            onClick: async () => {
                                await Mailora.post(bar.dataset.archiveUrl, { ids });
                                location.reload();
                            }
                        });
                        if (!rows().length) setTimeout(() => location.reload(), 5200);
                    } else if (btn.dataset.bulk === 'restore') {
                        // Çöp Kutusu → mesajlar geldikleri klasöre döner (Folder hiç değişmemişti)
                        const result = await Mailora.post(bar.dataset.restoreUrl, { ids });
                        ids.forEach(id => rowById(id)?.remove());
                        refreshBar();
                        Mailora.showToast(`${result.count} mesaj geri alındı.`, 'bi-arrow-counterclockwise');
                        if (!rows().length) setTimeout(() => location.reload(), 1500);
                    } else if (btn.dataset.bulk === 'forever') {
                        // Geri alınamaz işlem → ÖNCE onay (geri alınabilir işlemde "Geri al" toast'u yeterliydi)
                        if (!confirm(`${ids.length} mesaj kalıcı olarak silinecek. Bu işlem geri alınamaz. Devam edilsin mi?`)) return;
                        const result = await Mailora.post(bar.dataset.foreverUrl, { ids });
                        ids.forEach(id => rowById(id)?.remove());
                        refreshBar();
                        Mailora.showToast(`${result.count} mesaj kalıcı olarak silindi.`, 'bi-x-octagon');
                        if (!rows().length) setTimeout(() => location.reload(), 1500);
                    } else {
                        const isRead = btn.dataset.bulk === 'read';
                        const result = await Mailora.post(bar.dataset.readUrl, { ids, isRead });
                        ids.forEach(id => { const row = rowById(id); if (row) paintRead(row, isRead); });
                        Mailora.showToast(`${result.count} mesaj ${isRead ? 'okundu' : 'okunmadı'} olarak işaretlendi.`,
                            isRead ? 'bi-envelope-open' : 'bi-envelope');
                    }
                } catch (err) {
                    if (err.message !== '401') Mailora.showToast('İşlem kaydedilemedi.', 'bi-exclamation-circle');
                }
            });
        })();
    </script>
}