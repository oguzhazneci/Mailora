@model CreateMessageViewModel

@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.Rendering
@using MYAcademy_IdentityEmailProject.Services
@using MYAcademy_IdentityEmailProject.Helpers
@{
    // Taslak düzenleniyorsa aynı sayfa "Taslağı Düzenle" olur (9.6)
    bool isDraftEdit = Model.DraftId.HasValue;
    // Yanıtla / İlet modunda controller başlığı verir (9.7)
    string heading = ViewData["ComposeHeading"] as string ?? (isDraftEdit ? "Taslağı Düzenle" : "Yeni Mesaj");
    ViewData["Title"] = heading;
    ViewData["ActiveMenu"] = isDraftEdit ? "drafts" : "compose";        // Sidebar'daki data-page="compose" / data-menu="compose" linkini aktif yapar
    Layout = "_MessageLayout";

    // Controller'da: LoadCategoriesAsync() → ViewBag.Categories = SelectList
    var categories = ViewBag.Categories as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();

    var userName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name ?? "";
    var userEmail = User.FindFirstValue(ClaimTypes.Email) ?? "";

    // Sunucu tarafı (ModelState) hataları
    string ErrClass(string key) => ViewData.ModelState.TryGetValue(key, out var e) && e.Errors.Count > 0 ? "has-error" : "";
    string? ErrText(string key) => ViewData.ModelState.TryGetValue(key, out var e) ? e.Errors.FirstOrDefault()?.ErrorMessage : null;
    var generalError = ErrText(string.Empty);   // ModelState.AddModelError("", "...") ile eklenen genel hata
}

<style>
    /* Kategori dropdown'u — compose satırlarıyla uyumlu sade görünüm */
    .cmp-select-wrap {
        position: relative;
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
    }

    .cmp-select {
        width: 100%;
        appearance: none;
        -webkit-appearance: none;
        border: 0;
        outline: 0;
        background: transparent;
        font: inherit;
        color: inherit;
        padding: 6px 28px 6px 0;
        cursor: pointer;
    }

        .cmp-select:invalid, .cmp-select option[value=""] {
            color: var(--muted, #85899B);
        }

        .cmp-select option {
            color: #303348;
        }

    .cmp-select-wrap .bi-chevron-down {
        position: absolute;
        right: 4px;
        pointer-events: none;
        color: var(--muted, #85899B);
        font-size: .8rem;
    }

    .cmp-select-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent, #8B7FD6);
        margin-right: 10px;
        flex: none;
        opacity: 0;
        transition: opacity .2s;
    }

    .cmp-select-wrap.has-value .cmp-select-dot {
        opacity: 1;
    }
    /* Ekler (12.16) */
    .cmp-attach {
        padding: 12px 20px;
        border-top: 1px solid var(--border, #ECEAF5);
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .att-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

        .att-list:not(:has(li)) {
            display: none;
        }

    .att-item {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        max-width: 100%;
        padding: 6px 6px 6px 10px;
        border: 1px solid var(--border, #ECEAF5);
        border-radius: 10px;
        background: #FAF9FE;
        font-size: .85rem;
    }

        .att-item .n {
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .att-item .s {
            color: var(--muted, #85899B);
            font-size: .78rem;
        }

        .att-item .x {
            border: 0;
            background: transparent;
            color: var(--muted, #85899B);
            border-radius: 6px;
            padding: 0 4px;
            line-height: 1;
        }

            .att-item .x:hover {
                background: #EFEDF8;
                color: #303348;
            }

        .att-item.uploading {
            opacity: .6;
        }

            .att-item.uploading .x {
                visibility: hidden;
            }

            .att-item.uploading .s::after {
                content: " · yükleniyor…";
            }

    .att-bar {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .att-bar[hidden] {
            display: none;
        }

    .att-pick {
        cursor: pointer;
    }

    .att-hint {
        color: var(--muted, #85899B);
        font-size: .8rem;
    }
    /* İletilecek ek (12.18): henüz kopyalanmadı → kesikli kenar */
    .att-item.forwarded {
        border-style: dashed;
    }
</style>

<section class="compose" id="compose">

    <div class="cmp-head">
        <div>
            <h1>@heading</h1>
            <p>@(isDraftEdit ? "Kaydedilmiş taslağınızı tamamlayın ve gönderin" : "Yeni bir e-posta oluşturun ve gönderin")</p>
        </div>
        <div class="cmp-status" id="cmpStatus" data-state="empty" aria-live="polite">
            <span class="sdot"></span><span class="stext">Yeni mesaj</span>
        </div>
    </div>

    @* novalidate: tarayıcının kendi balonları yerine aşağıdaki JS doğrulaması çalışır.
       Gerçek kontrol her zaman sunucuda (8.2); buradaki kontroller kullanıcıya hız kazandırır. *@
    <form class="cmp-card" id="cmpForm" asp-controller="Message" asp-action="CreateMessage" method="post" novalidate autocomplete="off">

        <!-- Alıcı, kategori & konu -->
        <div class="cmp-fields">
            <div class="cmp-row">
                <span class="cmp-label">Kimden</span>
                <div class="cmp-from">
                    <b>@userName</b>
                    @if (!string.IsNullOrEmpty(userEmail))
                    {
                        <span>&lt;@userEmail&gt;</span>
                    }
                </div>
            </div>

            @* Alıcılar (12.9). Sunucu üç DÜZ METİN alanı çizer ("a@x.com, b@y.com"): JS kapalıyken de çalışır.
               JS açılışta bunları kartlara (chip) çevirir; boş Bilgi/Gizli satırlarını gizler. *@
            <div class="cmp-row @ErrClass(nameof(Model.To))" id="rowTo">
                <label class="cmp-label" for="rfTo">Kime</label>
                <div class="rf-box" data-rf="To">
                    <input asp-for="To" id="rfTo" class="rf-input" type="text"
                           placeholder="ad@alanadi.com · birden fazla adresi virgülle ayırın" spellcheck="false" autocomplete="off">
                </div>
                <div class="rf-toggles" id="rfToggles" hidden>
                    <button type="button" data-rf-show="Cc" title="Bilgi (Cc) alıcısı ekle">Bilgi</button>
                    <button type="button" data-rf-show="Bcc" title="Gizli (Bcc) alıcı ekle">Gizli</button>
                </div>
                <div class="cmp-err">@ErrText(nameof(Model.To))</div>
            </div>

            <div class="cmp-row @ErrClass(nameof(Model.Cc))" id="rowCc">
                <label class="cmp-label" for="rfCc">Bilgi</label>
                <div class="rf-box" data-rf="Cc">
                    <input asp-for="Cc" id="rfCc" class="rf-input" type="text"
                           placeholder="Herkesin göreceği bilgi alıcıları" spellcheck="false" autocomplete="off">
                </div>
                <div class="cmp-err">@ErrText(nameof(Model.Cc))</div>
            </div>

            <div class="cmp-row @ErrClass(nameof(Model.Bcc))" id="rowBcc">
                <label class="cmp-label" for="rfBcc" title="Gizli alıcıları diğer alıcılar görmez">Gizli</label>
                <div class="rf-box" data-rf="Bcc">
                    <input asp-for="Bcc" id="rfBcc" class="rf-input" type="text"
                           placeholder="Diğer alıcıların görmeyeceği adresler" spellcheck="false" autocomplete="off">
                </div>
                <div class="cmp-err">@ErrText(nameof(Model.Bcc))</div>
            </div>

            <div class="cmp-row @ErrClass(nameof(Model.CategoryId))" id="rowCategory">
                <label class="cmp-label" for="cmpCategory">Kategori</label>
                <div class="cmp-select-wrap" id="cmpCategoryWrap">
                    <span class="cmp-select-dot"></span>
                    <select asp-for="CategoryId" asp-items="categories" id="cmpCategory" class="cmp-select" required>
                        <option value="">Kategori seçin…</option>
                    </select>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <div class="cmp-err">@ErrText(nameof(Model.CategoryId))</div>
            </div>

            <div class="cmp-row @ErrClass(nameof(Model.Subject))" id="rowSubject">
                <label class="cmp-label" for="cmpSubject">Konu</label>
                <input asp-for="Subject" id="cmpSubject" class="cmp-subject" type="text"
                       placeholder="Mesajınızın konusunu yazın..." maxlength="200">
                <div class="cmp-err">@ErrText(nameof(Model.Subject))</div>
            </div>
        </div>

        <!-- Rich text araç çubuğu -->
        <div class="cmp-toolbar" id="cmpToolbar" role="toolbar" aria-label="Biçimlendirme">
            <div class="tb-wrap">
                <button type="button" class="tb-btn tb-select" data-pop="block" title="Başlık biçimi"><span id="tbBlockLabel">Paragraf</span><i class="bi bi-chevron-down"></i></button>
                <div class="tb-pop tb-menu" data-pop-for="block">
                    <button type="button" data-block="p">Paragraf</button>
                    <button type="button" data-block="h1"><span class="bh1">Başlık 1</span></button>
                    <button type="button" data-block="h2"><span class="bh2">Başlık 2</span></button>
                    <button type="button" data-block="h3"><span class="bh3">Başlık 3</span></button>
                    <button type="button" data-block="blockquote"><span class="bq">Alıntı</span></button>
                </div>
            </div>
            <span class="tb-sep"></span>
            <button type="button" class="tb-btn" data-cmd="bold" title="Kalın (Ctrl+B)"><i class="bi bi-type-bold"></i></button>
            <button type="button" class="tb-btn" data-cmd="italic" title="İtalik (Ctrl+I)"><i class="bi bi-type-italic"></i></button>
            <button type="button" class="tb-btn" data-cmd="underline" title="Altı çizili (Ctrl+U)"><i class="bi bi-type-underline"></i></button>
            <button type="button" class="tb-btn" data-cmd="strikeThrough" title="Üstü çizili"><i class="bi bi-type-strikethrough"></i></button>
            <div class="tb-wrap">
                <button type="button" class="tb-btn" data-pop="color" title="Metin rengi"><i class="bi bi-fonts"></i><span class="cbar" id="tbColorBar"></span></button>
                <div class="tb-pop" data-pop-for="color">
                    <div class="tb-colors">
                        @foreach (var c in new[] { "#303348", "#85899B", "#8B7FD6", "#5A4FB0", "#4A7CC2", "#3E9A77", "#B88A12", "#C8774A", "#C2476B", "#E07597" })
                        {
                            <button type="button" class="sw" data-color="@c" style="background:@c" title="@c"></button>
                        }
                    </div>
                    <button type="button" class="tb-reset" data-color="#45485E"><i class="bi bi-arrow-counterclockwise"></i> Varsayılan renk</button>
                </div>
            </div>
            <span class="tb-sep"></span>
            <button type="button" class="tb-btn" data-cmd="insertUnorderedList" title="Madde işaretli liste"><i class="bi bi-list-ul"></i></button>
            <button type="button" class="tb-btn" data-cmd="insertOrderedList" title="Numaralı liste"><i class="bi bi-list-ol"></i></button>
            <div class="tb-wrap">
                <button type="button" class="tb-btn" data-pop="link" title="Bağlantı ekle"><i class="bi bi-link-45deg"></i></button>
                <div class="tb-pop tb-link" data-pop-for="link">
                    <div class="ttl">Bağlantı ekle</div>
                    <div class="r">
                        <input type="text" id="tbLinkInput" placeholder="https://ornek.com" spellcheck="false">
                        <button type="button" class="btn-mini" data-link="add">Ekle</button>
                    </div>
                    <button type="button" class="unl" data-link="remove"><i class="bi bi-link-45deg"></i> Bağlantıyı kaldır</button>
                </div>
            </div>
            <span class="tb-sep"></span>
            <button type="button" class="tb-btn" data-cmd="justifyLeft" title="Sola hizala"><i class="bi bi-text-left"></i></button>
            <button type="button" class="tb-btn" data-cmd="justifyCenter" title="Ortala"><i class="bi bi-text-center"></i></button>
            <button type="button" class="tb-btn" data-cmd="justifyRight" title="Sağa hizala"><i class="bi bi-text-right"></i></button>
            <span class="tb-sep"></span>
            <button type="button" class="tb-btn" data-cmd="removeFormat" title="Biçimlendirmeyi temizle"><i class="bi bi-eraser"></i></button>
            <div class="tb-end">
                <button type="button" class="tb-btn" data-cmd="undo" title="Geri al (Ctrl+Z)"><i class="bi bi-arrow-counterclockwise"></i></button>
                <button type="button" class="tb-btn" data-cmd="redo" title="Yinele (Ctrl+Y)"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
        </div>

        <!-- Editör (HTML içerik gizli Body alanına yazılır; sunucu temizler, 8.2) -->
        <div class="cmp-editor-wrap @ErrClass(nameof(Model.Body))" id="rowBody">
            <div class="cmp-editor" id="cmpEditor" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Mesaj içeriği"
                 data-placeholder="Merhaba, mesajınızı buraya yazmaya başlayın…">
                @Html.Raw(Model?.Body)
            </div>
            <input type="hidden" asp-for="Body" id="cmpContent">
            @* Düzenlenen taslağın Id'si. İstemciden gelir: sunucu sahipliğini ve hâlâ taslak olduğunu kontrol eder (9.6). *@
            <input type="hidden" asp-for="DraftId">
            @* İletilen mesajın Id'si (12.18). İstemciden gelir: sunucu bu mesajın bende kopyası olduğunu doğrular. *@
            <input type="hidden" asp-for="ForwardOf">
            <div class="cmp-counter" id="cmpCounter">0 kelime · 0 karakter</div>
            <div class="cmp-err">@ErrText(nameof(Model.Body))</div>
        </div>

        <!-- Ekler (12.16): dosya seçildiği anda yüklenir ve taslağa bağlanır (karar 2-A) -->
        <div class="cmp-attach" id="cmpAttach"
             data-upload-url="@Url.Action("UploadAttachment", "Message")"
             data-remove-url="@Url.Action("RemoveAttachment", "Message")"
             data-max-files="@AttachmentRules.MaxFiles"
             data-max-file="@AttachmentRules.MaxFileBytes"
             data-max-total="@AttachmentRules.MaxTotalBytes">
            <ul class="att-list" id="attList">
                @foreach (var a in Model.Attachments)
                {
                    @* İletilecek ek (12.18): henüz kopyalanmadı; Id'si forma gizli alanla gider (Kavram 2) *@
                    <li class="att-item @(a.Forwarded ? "forwarded" : "")" data-id="@a.Id" data-size="@a.Size"
                        data-forwarded="@(a.Forwarded ? "true" : null)"
                        title="@(a.Forwarded ? "İletilen mesajdan · gönderince kopyalanır" : null)">
                        <i class="bi @(a.Forwarded ? "bi-forward" : "bi-paperclip")"></i><span class="n" title="@a.Name">@a.Name</span><span class="s">@AttachmentDisplay.Size(a.Size)</span><button type="button" class="x" aria-label="@a.Name ekini kaldır"><i class="bi bi-x"></i></button>
                        @if (a.Forwarded)
                        {
                            <input type="hidden" name="ForwardAttachmentIds" value="@a.Id">
                        }
                    </li>
                }
            </ul>
            @* JS kapalıyken gizli: yükleme JS ile yapılır (Kavram 6) *@
            <div class="att-bar" id="attBar" hidden>
                @* name YOK: dosya form POST'una girmez, JS ayrı istekle yükler (Kavram 1) *@
                <label class="btn-soft att-pick">
                    <i class="bi bi-paperclip"></i> Dosya ekle
                    <input type="file" id="attInput" multiple accept="@AttachmentRules.AcceptAttribute" hidden>
                </label>
                <span class="att-hint">
                    En fazla @AttachmentRules.MaxFiles dosya · dosya başına @(AttachmentRules.MaxFileBytes / (1024 * 1024)) MB · toplam @(AttachmentRules.MaxTotalBytes / (1024 * 1024)) MB
                </span>
            </div>
        </div>

        <!-- Alt işlem çubuğu -->
        <div class="cmp-actions">
            @* İki gönder butonu, tek form: hangi butona basıldığı "intent" değeriyle sunucuya gider (9.6) *@
            <button type="submit" class="btn-send" id="cmpSend" name="intent" value="send"><span class="lbl"><i class="bi bi-send-fill"></i> Mesajı Gönder</span></button>
            <button type="submit" class="btn-soft" id="cmpDraft" name="intent" value="draft"><span class="lbl"><i class="bi bi-file-earmark-text"></i> Taslak Olarak Kaydet</span></button>
            <button type="button" class="btn-soft danger" id="cmpClear"><i class="bi bi-x-circle"></i> Temizle</button>
            <span class="cmp-hint"><span class="kbd-s">Ctrl</span> + <span class="kbd-s">Enter</span> ile gönder</span>
        </div>
    </form>

    <!-- Temizleme onay penceresi -->
    <div class="cmp-dialog" id="cmpDialog" hidden>
        <div class="cd-card" role="alertdialog" aria-modal="true" aria-labelledby="cdTitle">
            <div class="cd-ic"><i class="bi bi-exclamation-triangle"></i></div>
            <h5 id="cdTitle">Formu temizlemek istiyor musunuz?</h5>
            <p>Alıcı, kategori, konu ve mesaj içeriği silinecek. Ekler taslakta kalır.</p>
            <div class="cd-actions">
                <button type="button" class="btn-soft" data-dialog="cancel">Vazgeç</button>
                <button type="button" class="btn-soft danger-solid" data-dialog="ok"><i class="bi bi-trash3"></i> Evet, Temizle</button>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    <script>
        /* ======================================================================
           YENİ MESAJ — form normal POST ile gönderilir (Message/CreateMessage).
           JS: zengin metin editörü, istemci doğrulaması, Ctrl+Enter, temizle onayı.
           İstemci kuralları CreateMessageViewModel ile aynıdır (8.5); sunucu yine de her şeyi tekrar kontrol eder.
           ====================================================================== */
        (() => {
            const { $, $$, showToast } = window.Mailora;

            const EMAIL_RE = /^[^\s@@<>()[\],;:"]+@@[^\s@@<>()[\],;:"]+\.[a-z]{2,}$/i;

            // Sunucudaki kurallar ve mesajlar (CreateMessageViewModel) — iki tarafta aynı metin
            const RULES = { emailMax: 256, subjectMax: 200, bodyMax: 100000, maxRecipients: 20 };   // RecipientList ile aynı
            let savingDraft = false;   // durum metni: "Gönderiliyor…" mi "Kaydediliyor…" mu
            const MSG = {
                toRequired: 'En az bir alıcı girin.',
                toTooMany: n => `Bir mesaj en fazla 20 alıcıya gönderilebilir (şu an ${n}).`,
                toInvalid: list => `Geçersiz adres: ${list.slice(0, 3).join(', ')}${list.length > 3 ? ` (+${list.length - 3})` : ''}`,
                toTooLong: 'E-posta adresi en fazla 256 karakter olabilir.',
                category: 'Bir kategori seçin.',
                subjectRequired: 'Konu zorunludur.',
                subjectTooLong: 'Konu en fazla 200 karakter olabilir.',
                bodyRequired: 'Mesaj içeriği boş olamaz.',
                bodyTooLong: 'Mesaj içeriği çok uzun.',
                draftEmpty: 'Boş bir taslak kaydedilemez.'
            };
            const STATE_CMDS = ['bold', 'italic', 'underline', 'strikeThrough', 'insertUnorderedList', 'insertOrderedList', 'justifyLeft', 'justifyCenter', 'justifyRight'];
            const BLOCK_LABELS = { p: 'Paragraf', div: 'Paragraf', h1: 'Başlık 1', h2: 'Başlık 2', h3: 'Başlık 3', blockquote: 'Alıntı' };

            const form = $('#cmpForm'), editor = $('#cmpEditor'), content = $('#cmpContent');
            const category = $('#cmpCategory'), subject = $('#cmpSubject');
            let savedRange = null, dirty = false, sending = false;

            const textOf = html => { const d = document.createElement('div'); d.innerHTML = html || ''; return (d.textContent || '').trim(); };
            const escapeHtml = window.Mailora.escapeHtml;

            /* --- Durum göstergesi --- */
            function updateStatus() {
                const el = $('#cmpStatus');
                const empty = recipientCount() === 0 && !category.value && !subject.value.trim() && !textOf(editor.innerHTML);
                const state = sending ? 'saving' : empty ? 'empty' : 'dirty';
                el.dataset.state = state;
                $('.stext', el).textContent = { empty: 'Yeni mesaj', dirty: 'Gönderilmedi', saving: savingDraft ? 'Kaydediliyor…' : 'Gönderiliyor…' }[state];
            }
            function markDirty() { dirty = true; updateStatus(); }

            /* --- Hata gösterimi --- */
            function setFieldError(row, msg) {
                row.classList.add('has-error');
                $('.cmp-err', row).textContent = msg;
                row.classList.remove('shake'); void row.offsetWidth; row.classList.add('shake');
            }
            function clearFieldError(row) {
                if (!row || !row.classList.contains('has-error')) return;
                row.classList.remove('has-error');
                $('.cmp-err', row).textContent = '';
            }

            /* --- Editör --- */
            try { document.execCommand('defaultParagraphSeparator', false, 'p'); document.execCommand('styleWithCSS', false, true); } catch (e) { /* eski tarayıcı */ }

            function syncContent() {
                if (['<br>', '<p><br></p>', '<div><br></div>'].includes(editor.innerHTML.trim())) editor.innerHTML = '';
                content.value = editor.innerHTML;
            }

            function updateCounter() {
                const text = editor.innerText.replace(/\u00a0/g, ' ').trim();   // &nbsp; → normal boşluk
                const words = text ? text.split(/\s+/).length : 0;
                $('#cmpCounter').textContent = `${words.toLocaleString('tr-TR')} kelime · ${text.length.toLocaleString('tr-TR')} karakter`;
            }

            editor.addEventListener('input', () => { syncContent(); updateCounter(); clearFieldError($('#rowBody')); markDirty(); });
            editor.addEventListener('paste', e => {      // dışarıdan gelen biçimleri temizle
                const text = (e.clipboardData || window.clipboardData).getData('text/plain');
                e.preventDefault();
                document.execCommand('insertText', false, text);
            });

            function saveSelection() {
                const sel = window.getSelection();
                if (sel.rangeCount && editor.contains(sel.anchorNode)) savedRange = sel.getRangeAt(0).cloneRange();
            }
            function restoreSelection() {
                if (savedRange && editor.contains(savedRange.startContainer)) {
                    const sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(savedRange);
                }
            }

            function exec(cmd, value = null) {
                editor.focus();
                restoreSelection();
                document.execCommand(cmd, false, value);
                if (cmd === 'removeFormat') { document.execCommand('unlink'); document.execCommand('formatBlock', false, '<p>'); }
                saveSelection();
                syncContent(); updateCounter(); clearFieldError($('#rowBody')); markDirty(); updateToolbarState();
            }

            function insertLink() {
                const input = $('#tbLinkInput');
                const raw = input.value.trim();
                if (!raw) { input.focus(); return; }
                const url = /^(https?:|mailto:)/i.test(raw) ? raw : (EMAIL_RE.test(raw) ? 'mailto:' : 'https://') + raw;
                editor.focus(); restoreSelection();
                const sel = window.getSelection();
                if (!sel.rangeCount || sel.isCollapsed || !editor.contains(sel.anchorNode)) {
                    document.execCommand('insertHTML', false, `<a href="${escapeHtml(url)}">${escapeHtml(raw)}</a>&nbsp;`);
                } else {
                    document.execCommand('createLink', false, url);
                }
                input.value = '';
                closePops(); saveSelection();
                syncContent(); updateCounter(); clearFieldError($('#rowBody')); markDirty();
            }

            function updateToolbarState() {
                const tb = $('#cmpToolbar');
                const sel = window.getSelection();
                const inEditor = sel.rangeCount > 0 && editor.contains(sel.anchorNode);
                STATE_CMDS.forEach(c => {
                    let on = false;
                    if (inEditor) { try { on = document.queryCommandState(c); } catch (e) { on = false; } }
                    $(`[data-cmd="${c}"]`, tb)?.classList.toggle('active', on);
                });
                let block = '';
                if (inEditor) { try { block = String(document.queryCommandValue('formatBlock') || '').toLowerCase().replace(/[<>]/g, ''); } catch (e) { block = ''; } }
                $('#tbBlockLabel').textContent = BLOCK_LABELS[block] || 'Paragraf';
            }

            function togglePop(name, btn) {
                const pop = $(`[data-pop-for="${name}"]`);
                const willOpen = !pop.classList.contains('show');
                closePops();
                if (!willOpen) return;
                pop.classList.add('show');
                btn.classList.add('open');
                pop.style.left = '0px';                                   // ekran dışına taşmayı engelle
                const over = pop.getBoundingClientRect().right - (window.innerWidth - 12);
                if (over > 0) pop.style.left = `${-over}px`;
                if (name === 'link') setTimeout(() => $('#tbLinkInput').focus(), 30);
            }
            function closePops() {
                $$('.tb-pop.show').forEach(p => p.classList.remove('show'));
                $$('.tb-btn.open').forEach(b => b.classList.remove('open'));
            }

            const tb = $('#cmpToolbar');
            tb.addEventListener('mousedown', e => { if (e.target.closest('button') && !e.target.closest('.tb-link .r')) e.preventDefault(); });
            tb.addEventListener('click', e => {
                const btn = e.target.closest('button');
                if (!btn) return;
                if (btn.dataset.cmd) { closePops(); exec(btn.dataset.cmd); }
                else if (btn.dataset.pop) togglePop(btn.dataset.pop, btn);
                else if (btn.dataset.block) { exec('formatBlock', `<${btn.dataset.block}>`); closePops(); }
                else if (btn.dataset.color) { exec('foreColor', btn.dataset.color); $('#tbColorBar').style.background = btn.dataset.color; closePops(); }
                else if (btn.dataset.link === 'add') insertLink();
                else if (btn.dataset.link === 'remove') { exec('unlink'); closePops(); }
            });
            $('#tbLinkInput').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); insertLink(); } });

            document.addEventListener('selectionchange', () => { saveSelection(); updateToolbarState(); });
            document.addEventListener('mousedown', e => { if (!e.target.closest('.tb-wrap')) closePops(); });

            /* --- Alıcı alanları (12.9): metin → kartlar ---
               Gerçek değer, formdaki GİZLİ alanda virgülle birleşmiş metin olarak durur.
               Kurallar sunucudaki RecipientList ile aynı: büyük/küçük harf farksız tekilleştirme,
               öncelik Kime > Bilgi > Gizli, en fazla 20 alıcı. */
            const PRIORITY = { To: 0, Cc: 1, Bcc: 2 };
            const FIELD_LABEL = { To: 'Kime', Cc: 'Bilgi', Bcc: 'Gizli' };
            const fields = {};

            const recipientCount = () => Object.values(fields).reduce((n, f) => n + f.chips.length, 0);
            const findChip = email => {
                for (const f of Object.values(fields)) {
                    const chip = f.chips.find(c => c.email.toLowerCase() === email.toLowerCase());
                    if (chip) return { field: f, chip };
                }
                return null;
            };

            function createRecipientField(name) {
                const box = $(`[data-rf="${name}"]`);
                const input = $('.rf-input', box);
                const row = box.closest('.cmp-row');

                // Formun gerçek alanı: gizli input. Görünen input'tan "name" kaldırılır (çift gönderim olmasın).
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = name;
                form.appendChild(hidden);
                input.removeAttribute('name');

                const field = { name, row, input, chips: [] };
                const sync = () => { hidden.value = field.chips.map(c => c.email).join(', '); };

                field.add = (raw, silent = false) => {
                    raw.split(/[,;\s]+/).map(x => x.trim()).filter(Boolean).forEach(email => {
                        const existing = findChip(email);
                        if (existing) {
                            // Aynı adres zaten var: daha ÖNCELİKLİ alandaysa dokunma; değilse buraya taşı
                            if (PRIORITY[existing.field.name] <= PRIORITY[name]) {
                                if (!silent) showToast(`${email} zaten ${FIELD_LABEL[existing.field.name]} alanında.`, 'bi-info-circle');
                                return;
                            }
                            existing.field.remove(existing.chip, true);
                        }

                        const valid = EMAIL_RE.test(email) && email.length <= RULES.emailMax;
                        const el = document.createElement('span');
                        el.className = 'rf-chip' + (valid ? '' : ' invalid');
                        el.title = valid ? email : 'Geçersiz adres: düzeltmek için kaldırıp yeniden yazın';

                        const text = document.createElement('span');
                        text.className = 't';
                        text.textContent = email;                       // kullanıcı verisi: textContent, innerHTML değil

                        const x = document.createElement('button');
                        x.type = 'button';
                        x.className = 'x';
                        x.setAttribute('aria-label', `${email} adresini kaldır`);
                        x.innerHTML = '<i class="bi bi-x"></i>';

                        const chip = { email, el };
                        x.addEventListener('click', () => { field.remove(chip); input.focus(); });
                        el.append(text, x);
                        box.insertBefore(el, input);
                        field.chips.push(chip);
                    });
                    sync();
                    if (!silent) { clearFieldError(row); markDirty(); }
                };

                field.remove = (chip, silent = false) => {
                    field.chips.splice(field.chips.indexOf(chip), 1);
                    chip.el.remove();
                    sync();
                    if (!silent) markDirty();
                };

                field.clear = () => { field.chips.splice(0).forEach(c => c.el.remove()); input.value = ''; sync(); };

                // Yazılmakta olan adresi karta çevir (gönderimden önce, odaktan çıkınca)
                field.commit = () => { if (input.value.trim()) { field.add(input.value); input.value = ''; } };

                input.addEventListener('keydown', e => {
                    const separator = e.key === ',' || e.key === ';' || e.key === ' ' || (e.key === 'Enter' && !e.ctrlKey && !e.metaKey);
                    if (separator && input.value.trim()) { e.preventDefault(); field.commit(); return; }
                    if (e.key === 'Enter' && !e.ctrlKey && !e.metaKey) { e.preventDefault(); category.focus(); return; }   // boş alanda Enter → sonraki alan
                    if (e.key === 'Backspace' && !input.value && field.chips.length) field.remove(field.chips[field.chips.length - 1]);
                });
                input.addEventListener('blur', field.commit);
                input.addEventListener('paste', e => {
                    const pasted = e.clipboardData.getData('text');
                    if (/[,;\s]/.test(pasted)) { e.preventDefault(); field.add(input.value + pasted); input.value = ''; }
                });
                input.addEventListener('input', () => { clearFieldError(row); markDirty(); });
                box.addEventListener('click', e => { if (e.target === box) input.focus(); });

                // Başlangıç: sunucunun yazdığı metni kartlara çevir (taslak, yanıt, hata sonrası geri dönüş)
                const initial = input.value;
                input.value = '';
                field.add(initial, true);
                return field;
            }

            ['To', 'Cc', 'Bcc'].forEach(name => { fields[name] = createRecipientField(name); });

            // Bilgi / Gizli satırları: boşsa (ve hata yoksa) gizle, "Bilgi" / "Gizli" düğmeleriyle aç
            const toggles = $('#rfToggles');
            toggles.hidden = false;
            ['Cc', 'Bcc'].forEach(name => {
                const f = fields[name];
                const button = $(`[data-rf-show="${name}"]`, toggles);
                const inUse = f.chips.length > 0 || f.row.classList.contains('has-error');
                f.row.hidden = !inUse;
                button.classList.toggle('used', inUse);
                button.addEventListener('click', () => {
                    f.row.hidden = false;
                    button.classList.add('used');
                    f.input.focus();
                });
            });

            const syncCategory = () => $('#cmpCategoryWrap').classList.toggle('has-value', !!category.value);
            category.addEventListener('change', () => { syncCategory(); clearFieldError($('#rowCategory')); markDirty(); });

            subject.addEventListener('input', () => { clearFieldError($('#rowSubject')); markDirty(); });
            subject.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.ctrlKey && !e.metaKey) { e.preventDefault(); editor.focus(); } });

                        /* --- Ekler (12.16): seçilen dosya HEMEN yüklenir ve taslağa bağlanır (karar 2-A) ---
               Yüklemeler SIRAYLA yapılır: ilk istek (gerekirse) taslağı oluşturur,
               sonrakiler dönen draftId'yi kullanır (Kavram 3). */
            const attach = $('#cmpAttach'), attList = $('#attList'), attInput = $('#attInput');
            const draftIdInput = $('input[name="DraftId"]', form);
            const token = $('input[name="__RequestVerificationToken"]', form).value;
            const LIMITS = { files: +attach.dataset.maxFiles, file: +attach.dataset.maxFile, total: +attach.dataset.maxTotal };
            const MB = 1024 * 1024;
            let uploading = 0;                       // bekleyen + süren yüklemeler: bitmeden form gönderilmez (Kavram 4)
            let uploadQueue = Promise.resolve();

            const attachmentItems = () => $$('.att-item', attList);
            const attachmentCount = () => attachmentItems().length;
            const attachmentBytes = () => attachmentItems().reduce((n, li) => n + Number(li.dataset.size || 0), 0);
            const formatSize = b => b < MB
                ? `${Math.max(1, Math.round(b / 1024))} KB`
                : `${(b / MB).toLocaleString('tr-TR', { maximumFractionDigits: 1 })} MB`;

            // Dosya göndermek için FormData gerekir. Token formdaki gizli alandan (Kavram 2).
            const postForm = (url, values) => {
                const body = new FormData();
                Object.entries(values).forEach(([k, v]) => body.append(k, v));
                body.append('__RequestVerificationToken', token);
                return fetch(url, { method: 'POST', body });
            };

            function addAttachmentItem(name, size) {
                const li = document.createElement('li');
                li.className = 'att-item';
                li.dataset.size = size;
                li.innerHTML = '<i class="bi bi-paperclip"></i><span class="n"></span><span class="s"></span>' +
                               '<button type="button" class="x"><i class="bi bi-x"></i></button>';
                const n = $('.n', li);
                n.textContent = name;                // kullanıcı verisi: textContent (Kavram 5)
                n.title = name;
                $('.s', li).textContent = formatSize(size);
                $('.x', li).setAttribute('aria-label', `${name} ekini kaldır`);
                attList.appendChild(li);
                return li;
            }

            async function uploadOne(file, li) {
                const values = { file };
                if (draftIdInput.value) values.draftId = draftIdInput.value;

                try {
                    const res = await postForm(attach.dataset.uploadUrl, values);
                    if (res.status === 413) throw new Error(`Bir dosya en fazla ${LIMITS.file / MB} MB olabilir.`);

                    const data = await res.json().catch(() => null);      // oturum düşmüşse JSON yerine HTML gelir
                    if (!res.ok || !data?.attachment) throw new Error(data?.error || 'Dosya yüklenemedi.');

                    draftIdInput.value = data.draftId;                    // taslak yeni oluştuysa bundan sonra o kullanılır
                    li.dataset.id = data.attachment.id;
                    const n = $('.n', li);
                    n.textContent = n.title = data.attachment.name;       // sunucunun temizlediği ad (12.15.c)
                    li.classList.remove('uploading');
                } catch (err) {
                    li.remove();
                    // fetch'in kendi hatası (bağlantı koptu, sunucu isteği yarıda kesti) TypeError olarak gelir
                    const msg = err instanceof TypeError ? 'Dosya yüklenemedi: bağlantı hatası.' : err.message;
                    showToast(escapeHtml(msg), 'bi-exclamation-triangle');
                }
            }

            attInput.addEventListener('change', () => {
                const files = [...attInput.files];
                attInput.value = '';                 // aynı dosya bir daha seçilebilsin
                let count = attachmentCount(), total = attachmentBytes();

                for (const file of files) {
                    // Ön kontrol: kullanıcıyı boşuna bekletmemek için. Asıl kontrol sunucuda.
                    if (count >= LIMITS.files) {
                        showToast(`Bir mesaja en fazla ${LIMITS.files} dosya eklenebilir.`, 'bi-exclamation-circle');
                        break;
                    }
                    if (file.size > LIMITS.file) {
                        showToast(`${escapeHtml(file.name)}: bir dosya en fazla ${LIMITS.file / MB} MB olabilir.`, 'bi-exclamation-circle');
                        continue;
                    }
                    if (total + file.size > LIMITS.total) {
                        showToast(`${escapeHtml(file.name)}: eklerin toplamı ${LIMITS.total / MB} MB'ı aşıyor.`, 'bi-exclamation-circle');
                        continue;
                    }
                    count++;
                    total += file.size;

                    const li = addAttachmentItem(file.name, file.size);
                    li.classList.add('uploading');
                    uploading++;
                    // Kuyruğun SONUNA ekle: önceki yükleme bitmeden bu başlamaz (Kavram 3)
                    uploadQueue = uploadQueue.then(() => uploadOne(file, li)).finally(() => { uploading--; });
                }
            });

            attList.addEventListener('click', async e => {
                const btn = e.target.closest('.x');
                if (!btn) return;
                const li = btn.closest('.att-item');
                // İletilecek ek henüz kopyalanmadı: sunucuda silinecek bir şey yok.
                // li silinince içindeki gizli Id alanı da gider (Kavram 1 ve 2).
                if (li.dataset.forwarded) { li.remove(); return; }
                if (li.classList.contains('uploading') || !li.dataset.id) return;   // Id gelmeden kaldırılamaz

                btn.disabled = true;
                try {
                    const res = await postForm(attach.dataset.removeUrl, { id: li.dataset.id });
                    if (!res.ok) throw new Error();
                    li.remove();
                } catch {
                    btn.disabled = false;
                    showToast('Ek kaldırılamadı.', 'bi-exclamation-triangle');
                }
            });

            $('#attBar').hidden = false;             // JS çalışıyor: ek çubuğunu göster (Kavram 6)

            /* --- Doğrulama & gönderim --- */
            function validate() {
                let first = null;
                const fail = (row, msg, el) => { setFieldError(row, msg); if (!first) first = el; };
                const subj = subject.value.trim();

                // Alıcılar: sunucudaki ValidateRecipients ile aynı kurallar ve metinler
                const total = recipientCount();
                if (total === 0) fail(fields.To.row, MSG.toRequired, fields.To.input);
                else if (total > RULES.maxRecipients) fail(fields.To.row, MSG.toTooMany(total), fields.To.input);
                Object.values(fields).forEach(f => {
                    const bad = f.chips.map(c => c.email).filter(e => !EMAIL_RE.test(e) || e.length > RULES.emailMax);
                    if (bad.length) {
                        f.row.hidden = false;
                        fail(f.row, MSG.toInvalid(bad), f.input);
                    }
                });

                if (!category.value) fail($('#rowCategory'), MSG.category, category);

                if (!subj) fail($('#rowSubject'), MSG.subjectRequired, subject);
                else if (subj.length > RULES.subjectMax) fail($('#rowSubject'), MSG.subjectTooLong, subject);

                // Sunucu: [Required] + HasVisibleText (görünür metin) ve StringLength(100_000) HTML'in tamamına
                if (!textOf(editor.innerHTML)) fail($('#rowBody'), MSG.bodyRequired, editor);
                else if (content.value.length > RULES.bodyMax) fail($('#rowBody'), MSG.bodyTooLong, editor);

                if (first) { first.focus(); return false; }
                return true;
            }

            // Taslak kuralları: eksik olabilir, ama boş olamaz ve sınırları aşamaz (sunucudaki ValidateDraft ile aynı)
            function validateDraft() {
                let first = null;
                const fail = (row, msg, el) => { setFieldError(row, msg); if (!first) first = el; };
                                const empty = recipientCount() === 0 && !category.value && !subject.value.trim() && !textOf(editor.innerHTML)
                              && attachmentCount() === 0;   // 12.16: sadece eki olan taslak boş değildir

                if (empty) { showToast(MSG.draftEmpty, 'bi-info-circle'); return false; }
                if (recipientCount() > RULES.maxRecipients) fail(fields.To.row, MSG.toTooMany(recipientCount()), fields.To.input);
                Object.values(fields).forEach(f => {
                    if (f.chips.some(c => c.email.length > RULES.emailMax)) fail(f.row, MSG.toTooLong, f.input);
                });
                if (subject.value.trim().length > RULES.subjectMax) fail($('#rowSubject'), MSG.subjectTooLong, subject);
                if (content.value.length > RULES.bodyMax) fail($('#rowBody'), MSG.bodyTooLong, editor);

                if (first) { first.focus(); return false; }
                return true;
            }

            form.addEventListener('submit', e => {
                closePops();
                Object.values(fields).forEach(f => f.commit());     // yarım kalan adres de kart olsun
                syncContent();
                if (sending) { e.preventDefault(); return; }

                // Ekler yüklenirken gönderme ya da kaydetme yok: DraftId henüz gelmemiş olabilir (Kavram 4)
                if (uploading > 0) {
                    e.preventDefault();
                    showToast('Ekler yükleniyor, lütfen bitmesini bekleyin.', 'bi-hourglass-split');
                    return;
                }

                // Hangi buton? Ctrl+Enter (requestSubmit) butonsuz gönderir → "send" sayılır.
                const isDraft = e.submitter?.value === 'draft';
                const ok = isDraft ? validateDraft() : validate();
                if (!ok) {
                    e.preventDefault();
                    if (!isDraft) showToast('Lütfen işaretli alanları kontrol edin.', 'bi-exclamation-circle');
                    return;
                }

                sending = true; dirty = false; savingDraft = isDraft;
                // Butonu "disabled" YAPMIYORUZ: disabled bir buton forma eklenmez ve intent değeri kaybolur.
                // Çift tıklamayı "sending" bayrağı engelliyor; buton sadece görsel olarak meşgul gösteriliyor.
                const btn = isDraft ? $('#cmpDraft') : $('#cmpSend');
                btn.setAttribute('aria-busy', 'true');
                btn.style.pointerEvents = 'none';
                $('.lbl', btn).innerHTML = `<span class="spin"></span> ${isDraft ? 'Kaydediliyor…' : 'Gönderiliyor…'}`;
                updateStatus();
                // Form normal şekilde POST edilir → MessageController.CreateMessage(model, intent)
            });

            /* --- Temizle (onaylı) --- */
            const dialog = $('#cmpDialog');
            const openClear = () => {
                const empty = recipientCount() === 0 && !category.value && !subject.value.trim() && !textOf(editor.innerHTML);
                if (empty) { showToast('Form zaten boş.', 'bi-info-circle'); return; }
                dialog.hidden = false;
                $('[data-dialog="cancel"]', dialog).focus();
            };
            const closeClear = () => { dialog.hidden = true; };

            $('#cmpClear').addEventListener('click', openClear);
            dialog.addEventListener('click', e => {
                const act = e.target.closest('[data-dialog]')?.dataset.dialog;
                if (act === 'ok') {
                    Object.values(fields).forEach(f => { f.clear(); clearFieldError(f.row); });
                    category.value = ''; subject.value = ''; editor.innerHTML = '';
                    syncContent(); syncCategory(); updateCounter();
                    ['#rowCategory', '#rowSubject', '#rowBody'].forEach(s => clearFieldError($(s)));
                    dirty = false; savedRange = null;
                    closeClear(); updateStatus();
                    showToast('Form temizlendi.', 'bi-eraser');
                    fields.To.input.focus();
                } else if (act === 'cancel' || e.target === dialog) closeClear();
            });

            /* --- Kısayollar --- */
            $('#compose').addEventListener('keydown', e => {
                const mod = e.ctrlKey || e.metaKey;
                if (mod && e.key === 'Enter') { e.preventDefault(); form.requestSubmit(); }
                if (e.key === 'Escape') { closePops(); closeClear(); }
            });

            // Kaydedilmemiş içerikle sayfadan çıkarken uyar
            window.addEventListener('beforeunload', e => { if ((dirty || uploading > 0) && !sending) { e.preventDefault(); e.returnValue = ''; } });

            /* --- Başlangıç --- */
            syncContent();
            syncCategory();
            updateCounter();
            updateStatus();
            dirty = false;

            const generalError = @Json.Serialize(generalError);
            if (generalError) showToast(escapeHtml(generalError), 'bi-exclamation-circle');

            // İlk hatalı alana ya da boş alana odaklan
            const firstErr = $('#compose .has-error input, #compose .has-error select, #compose .has-error .cmp-editor');
            if (firstErr) firstErr.focus();
            else if (window.innerWidth >= 768) (recipientCount() === 0 ? fields.To.input : !category.value ? category : !subject.value ? subject : editor).focus();
        })();
    </script>
}