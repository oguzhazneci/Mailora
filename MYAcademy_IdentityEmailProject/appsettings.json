{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Initial Catalog=IdentityEmailDb;Integrated Security=true;TrustServerCertificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AuthMail": {
      "PermitLimit": 5,
      "WindowSeconds": 900
    },
    "Lookup": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "UserSend": {
      "PermitLimit": 30,
      "WindowSeconds": 600
    },
    "UserUpload": {
      "PermitLimit": 60,
      "WindowSeconds": 600
    }
  },
  "AllowedHosts": "localhost",
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "Mailora"
  }
}